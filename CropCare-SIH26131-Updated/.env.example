# Copy this file to .env if you need to override defaults.

# Only needed if your FastAPI backend runs somewhere other than
# http://127.0.0.1:8000 during `npm run dev`. Used by vite.config.js
# to proxy /api/* requests to the backend (avoids CORS entirely).
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Only needed for a PRODUCTION build (npm run build), where Vite's dev
# proxy no longer exists. Point this at your deployed backend's full
# URL. NOTE: the backend will then need CORS enabled for your frontend's
# domain - ask whoever owns main.py to add FastAPI's CORSMiddleware.
# VITE_API_BASE_URL=https://your-deployed-backend.example.com
